# M-Store Frontend Client Environment Configuration Template

# Production Domain Site URL (Vercel Deployment)
VITE_SITE_URL=https://m-store-two.vercel.app

# Production Express REST API Backend URL (Render Deployment)
VITE_API_URL=https://m-store-backend.onrender.com/api

# WhatsApp Product Enquiry Number (Country code + Number, Digits only)
VITE_WHATSAPP_NUMBER=918891003031

# Optional Direct Unsigned Cloudinary Upload Settings (Fallback)
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=mstore_preset
