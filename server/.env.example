# M-Store Backend Environment Configuration Template
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/mstore_db?retryWrites=true&w=majority

# Secret for signing JWT authentication tokens
JWT_SECRET=your_production_jwt_secret_here_key_2026

# Controlled Production Admin Credentials (Configured via Render Environment Variables)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-strong-admin-password

# Allowed Client Origin for CORS Verification
CLIENT_URL=https://mstore.in

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
